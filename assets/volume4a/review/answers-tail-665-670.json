  "substantiveCorrections": [
    {
      "id": "volume4a-tail-answer-051",
      "section": "7.2.1.5",
      "cnPdfPage": 665,
      "enPdfPages": [
        792
      ],
      "location": "答53严格泰勒余项界的取值域",
      "original": "|t|\\leq\\delta",
      "final": "0<|t|\\leq\\delta",
      "basis": "t=0时原严格式为0<0。对0<|t|≤δ取常规绝对值余项界∑|κⱼ||t|ʲ；t=0等号显式排除，无涉后续积分范围。",
      "isAuthorOfficialErratum": false,
      "isProjectMathematicalCorrection": true,
      "cnPrintedPage": 650,
      "pageMarkdownSha256": "a45773605aa81dead150d0562c9860d3109e6a95d5f55d182969cb3bde44b5da"
    },
    {
      "id": "volume4a-tail-answer-052",
      "section": "7.2.1.5",
      "cnPdfPage": 665,
      "enPdfPages": [
        792
      ],
      "location": "答53特征函数取模的等号条件",
      "original": "各项并没有都位于一条直线上",
      "final": "各非零项 $p_ke^{kit}$ 不可能全指向同一方向",
      "basis": "三角不等式等号只看同向。p₀=p₁=1/2,t=π时两项均在实轴而取相反方向，|G|=0。p₀>0固定同向相位为1，支持指标公因数为1排除δ≤|t|≤π时同向。",
      "isAuthorOfficialErratum": false,
      "isProjectMathematicalCorrection": true,
      "cnPrintedPage": 650,
      "pageMarkdownSha256": "a45773605aa81dead150d0562c9860d3109e6a95d5f55d182969cb3bde44b5da"
    },
    {
      "id": "volume4a-tail-answer-053",
      "section": "7.2.1.5",
      "cnPdfPage": 665,
      "enPdfPages": [
        792
      ],
      "location": "答55牛顿步分母指数",
      "original": "1-ce^{-\\beta_k}",
      "final": "1-ce^{\\beta_k}",
      "basis": "对β−ce^β用牛顿法直接得分母1−ce^β。以α=ln4作160位十进制有限复算，正确第七步距ln2为6.85856×10⁻⁷⁶，原负指数步仍差0.290128。",
      "isAuthorOfficialErratum": false,
      "isProjectMathematicalCorrection": true,
      "cnPrintedPage": 650,
      "pageMarkdownSha256": "a45773605aa81dead150d0562c9860d3109e6a95d5f55d182969cb3bde44b5da"
    },
    {
      "id": "volume4a-tail-answer-054",
      "section": "7.2.1.5",
      "cnPdfPage": 665,
      "enPdfPages": [
        793
      ],
      "location": "答56(c)归一化导数的不等号与幂次",
      "original": "n!(1-\\beta/\\alpha)<(-\\sigma)^ng^{(n+1)}(\\sigma)<0",
      "final": "0<(-\\sigma)^{n+1}g^{(n+1)}(\\sigma)<n!(1-\\beta/\\alpha)",
      "basis": "两源的原左端为正而右端为0。按题(a)(b)，归一导数为n!减去介于(β/α)n!与n!的和，恰得到式(42)所需界；σ=ln2、n=1,2独立核。",
      "isAuthorOfficialErratum": false,
      "isProjectMathematicalCorrection": true,
      "cnPrintedPage": 650,
      "pageMarkdownSha256": "a45773605aa81dead150d0562c9860d3109e6a95d5f55d182969cb3bde44b5da"
    },
    {
      "id": "volume4a-tail-answer-055",
      "section": "7.2.1.5",
      "cnPdfPage": 666,
      "enPdfPages": [
        793
      ],
      "location": "答58(a)比较式在t=π的连续写法",
      "original": "8u\\sin u\\cos u(u-\\tan u)",
      "final": "8u\\sin u(u\\cos u-\\sin u)",
      "basis": "原式在u=π/2未定义，比较范围包括该点。把cos与括号相乘并用sin替换cos·tan，保留恒等式且全范围有定义。",
      "isAuthorOfficialErratum": false,
      "isProjectMathematicalCorrection": true,
      "cnPrintedPage": 651,
      "pageMarkdownSha256": "4117af717e4ce92a17483d558776d1298ed9ff87f03f7b133ac17346391ec166"
    },
