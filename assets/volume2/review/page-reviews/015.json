    "methodCode": "def algorithm_k(x):\n    y=x//10**9; trace=[('K1',f'{x:010}',None)]\n    while True:\n        z=(x//10**8)%10\n        for step in range(3+z,13):\n            if step==3:\n                if x<5000000000: x+=5000000000\n            elif step==4: x=(x*x//10**5)%10**10\n            elif step in [5,8]: x=(1001001001*x)%10**10\n            elif step==6: x=x+9814055677 if x<100000000 else 10**10-x\n            elif step==7: x=10**5*(x%10**5)+x//10**5\n            elif step==9: x=int(''.join(str(max(int(c)-1,0)) for c in f'{x:010}'))\n            elif step==10: x=x*x+99999 if x<10**5 else x-99999\n            elif step==11:\n                assert x>0\n                while x<10**9: x*=10\n            elif step==12: x=(x*(x-1)//10**5)%10**10\n            trace.append((f'K{step}',f'{x:010}',y if step==12 else None))\n        if y==0: return x,trace\n        y-=1\n",
