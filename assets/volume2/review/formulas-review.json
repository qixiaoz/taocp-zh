      "tex": "(x_1u_1+\\cdots+x_tu_t)^2\\le(x_1^2+\\cdots+x_t^2)(u_1^2+\\cdots+u_t^2),\\tag{13}",
      "texSha256": "726ac16d2d8c4ca512af87a6f398c3989c031ceb7a597ffa763e7a494d4330db",
      "cnPdfPage": 85,
      "cnPrintedPage": 74,
