      "sampleStartLine": 11,
      "sampleEndLine": 14,
      "tex": "\\min_{\\text{实数 }x_1,\\ldots,x_t}\n\\left\\{\\sqrt{x_1^2+\\cdots+x_t^2}\\;\\middle|\\;x_1u_1+\\cdots+x_tu_t=1\\right\\}.\\tag{12}",
      "texSha256": "128cd6635fe387d172ee00a2c66df5e1c789ef77ac3481146b95c8889bc3e999",
      "cnPdfPage": 85,
      "cnPrintedPage": 74,
