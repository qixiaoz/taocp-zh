      "finding": "左端整体平方；右端两组平方和相乘；方向≤及下标端点正确。"
    },
    {
      "number": 14,
      "section": "3.3.4",
      "sampleStartLine": 24,
      "sampleEndLine": 26,
      "tex": "1/\\sqrt{u_1^2+\\cdots+u_t^2}=1/\\text{长度}(U).\\tag{14}",
      "texSha256": "8c9fdf17ef7c71f05a7acca75c64560bc263ccb904e4c03b9973a7a5c5f37ee4",
      "cnPdfPage": 85,
      "cnPrintedPage": 74,
